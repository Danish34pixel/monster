# Used only for CORS now (see FRONTEND_URLS) — NOT used for password-reset
# links anymore. The reset-password page is server-rendered by this backend
# itself (routes/resetPasswordPage.js); see RESET_PASSWORD_BASE_URL below.
FRONTEND_URL=http://localhost:8081

# Base URL the password-reset link points to — this backend now serves the
# reset-password page itself (GET/POST /reset-password/:token), so no
# separate frontend deployment is required for this flow. Defaults to
# https://api.medi-trap.com if unset (see controllers/passwordController.js);
# override only for local/staging testing, e.g. http://localhost:5002.
RESET_PASSWORD_BASE_URL=https://api.medi-trap.com

# Extra admin emails (comma separated). Useful for granting admin access without DB changes in dev.
