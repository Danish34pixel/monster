# Email / SMTP — Gmail account dedicated to password-reset (and other
# transactional) email. utils/mailer.js reads SMTP_* first, falling back to
# EMAIL_* — both are set here so a stale value in either one can't silently
# win. SMTP_PASS / EMAIL_PASS must be a Gmail *App Password* (Google Account
# -> Security -> 2-Step Verification -> App passwords, 16 characters, spaces
# in the dashboard display are cosmetic), not the account's login password —
# using the login password is what produces "535-5.7.8 Username and Password
# not accepted". Ethereal (the fake test inbox) must stay disabled for this
# flow (USE_ETHEREAL=false); mailer.js's startup check
# (verifyMailerOnStartup) logs SMTP_USER and the password length, then runs
# transporter.verify() against Gmail so a bad App Password is caught in
# server logs at boot instead of on the first forgot-password request.
USE_ETHEREAL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=meditrap1@gmail.com
SMTP_PASS=<GMAIL_APP_PASSWORD>
SMTP_FROM="MediTrap Support <meditrap1@gmail.com>"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=meditrap1@gmail.com
EMAIL_PASS=<GMAIL_APP_PASSWORD>
EMAIL_SECURE=false
EMAIL_FROM="MediTrap Support <meditrap1@gmail.com>"

# Password reset rate limit — max forgot-password/reset-password requests
# per IP per 15-minute window (defaults to 5 if unset).
PASSWORD_RESET_RATE_LIMIT_MAX=5

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

