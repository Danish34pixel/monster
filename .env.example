NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://localhost:27017/medtek
JWT_SECRET=replace_with_64_plus_char_secret
JWT_REFRESH_SECRET=replace_with_64_plus_char_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
FRONTEND_URL=https://your-frontend.example.com
FRONTEND_URLS=https://your-frontend.example.com,https://admin.your-frontend.example.com
GLOBAL_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Cloudinary (required in production unless you intentionally disable uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DISABLED=0

# Mail
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=no-reply@your-domain.com

# Razorpay (required for payment flow)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan amounts in paise (INR × 100); defaults: ₹999 and ₹499
PLAN_AMOUNT_MEDICAL_OWNER=99900
PLAN_AMOUNT_PURCHASER=49900

# Optional
REDIS_URL=
